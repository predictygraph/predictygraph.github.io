# Generated by scripts/render_examples.py; edit the template there.
graph theme=dracula dir=LR route=bend

user "User"
group cluster "Cluster" layout=layered dir=TB {
  api "API" .accent border=pulse
  sched "Scheduler"
  api -> sched
}
group pool "GPU pool" layout=grid cols=2 {
  g0 "GPU 0" .green; g1 "GPU 1" .green
  g2 "GPU 2" .yellow; g3 "GPU 3" .red
}
db "Store" shape=cylinder .blue

user -> api flow=forward
sched -> pool .accent flow=forward
sched ..> db
