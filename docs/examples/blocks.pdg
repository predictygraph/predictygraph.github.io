graph dir=LR route=ortho
css "theme.css"
let model = "H100"

def server gpus=2 {
  cpu "CPU"
  gpu "${model} x${gpus}" .gpu
  cpu -> gpu
}

sched "HAMi scheduler" .hami
group rack "Rack" layout=column {
  use server node1 "Node 1"
  use server node2 "Node 2" gpus=8
}
sched -> node1-cpu, node2-cpu
